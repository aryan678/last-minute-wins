# Copy to backend/.env for local use. Never commit the populated file.
APP_ENV=demo
CORS_ALLOWED_ORIGINS=http://localhost:3000
MAX_UPLOAD_MB=10
# SCENARIO_DATE=2026-10-17

# Google Cloud (all optional. Empty values keep the demo fallback)
GOOGLE_CLOUD_PROJECT=ai-builder-cup-511918
GOOGLE_CLOUD_REGION=us-central1
GEMINI_ENABLED=true
VERTEX_GEMINI_MODEL=gemini-2.5-flash
BIGQUERY_DATASET=claimwise
GCS_BUCKET=claimwise-uploads
DOCUMENT_AI_PROCESSOR_ID=claimwise_formparser
DOCUMENT_AI_LOCATION=us
VERTEX_SEARCH_DATASTORE_ID=claimwise-datastore_1792301613713
